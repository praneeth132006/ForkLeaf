# ─── ForkLeaf configuration ──────────────────────────────────────────────────
#
# Copy this file to apps/web/.env.local and fill it in.
#
# NONE of these are required to run the app: with no configuration ForkLeaf
# starts in local mode, where notes are stored in the browser. They are only
# needed to sync notes to GitHub and to collect analytics.

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# This is what turns on sign-in and repository sync. Create an OAuth app at:
#   GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#
#   Homepage URL:                http://localhost:3000
#   Authorization callback URL:  http://localhost:3000/api/auth/callback
#
# Development and production need SEPARATE OAuth apps — each app has exactly one
# callback URL.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ─── Session encryption ──────────────────────────────────────────────────────
# Encrypts the GitHub access token into an httpOnly cookie. Must be at least 32
# characters and must be kept secret — anyone holding it can forge a session.
#
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# ─── Public URL ──────────────────────────────────────────────────────────────
# The origin the app is served from. Used to build the OAuth callback URL, which
# must match what is registered on the OAuth app exactly. Required when running
# behind a proxy or on a deployed domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Firebase (optional) ─────────────────────────────────────────────────────
# Powers product analytics, the per-user account record, and the billing
# scaffold. Leave blank and every Firebase call becomes a no-op — the editor is
# unaffected.
#
# From: Firebase console → Project settings → Your apps → Web app → SDK config.
#
# These are NEXT_PUBLIC_ because a Firebase web config is shipped to every
# browser by design; the apiKey identifies the project rather than authorising
# access. What protects the data is firestore.rules in the repository root.
#
# In the Firebase console you also need to enable:
#   Authentication → Sign-in method → Anonymous
#   Firestore Database (production mode)
# then deploy the rules:  firebase deploy --only firestore:rules
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
