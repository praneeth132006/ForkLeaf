# ─── mdnotion configuration ──────────────────────────────────────────────────
#
# Copy this file to apps/web/.env.local and fill it in.
#
# NONE of these are required to run the app: with no configuration mdnotion
# starts in local mode, where notes are stored in the browser. They are only
# needed to sync notes to GitHub.

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# Create an OAuth app at:
#   GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#
#   Homepage URL:                http://localhost:3000
#   Authorization callback URL:  http://localhost:3000/api/auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ─── Session encryption ──────────────────────────────────────────────────────
# Encrypts the GitHub access token into an httpOnly cookie. Must be at least 32
# characters and must be kept secret — anyone holding it can forge a session.
#
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# ─── Public URL ──────────────────────────────────────────────────────────────
# The origin the app is served from. Used to build the OAuth callback URL, which
# must match what is registered on the OAuth app exactly. Required when running
# behind a proxy or on a deployed domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
