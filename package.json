{
  "name": "forkleaf",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first Markdown notes editor with first-class Mermaid diagrams that uses your own GitHub repositories as storage.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/praneeth132006/ForkLeaf.git"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.4.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.5",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "undici@>=7.0.0 <7.29.1": "^7.29.1",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "@grpc/grpc-js@<1.13.6": "^1.13.6",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "markdown-it@<14.3.1": "^14.3.1",
      "@next/eslint-plugin-next>fast-glob": "npm:tinyglobby@^0.2.17",
      "katex@<0.18.2": "^0.19.0"
    }
  }
}
